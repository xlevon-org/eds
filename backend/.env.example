# Copy to backend/.env and fill values. Never commit the filled file.

NODE_ENV=development
PORT=5000

# MongoDB (leave blank in development to boot without a database)
MONGODB_URI=

# Auth
JWT_SECRET=change-me-at-least-32-random-characters
JWT_EXPIRES=7d

# CORS: comma-separated allow-list
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Cloudinary (media upload; leave blank to disable upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=up

# Uploads
MAX_UPLOAD_MB=50

# Python generation worker (internal; never expose publicly)
WORKER_BASE_URL=http://localhost:8000
WORKER_API_KEY=change-me-shared-with-worker

# Public base URL of this API
PUBLIC_BASE_URL=http://localhost:5000
