# Copy to worker/.env and fill values. Never commit the filled file.

# Server
WORKER_PORT=8000
HOST=127.0.0.1

# Shared secret with the Express backend (required for all non-health routes)
WORKER_API_KEY=change-me-shared-with-worker

# Backend base URL used for callbacks / artifact handoff
BACKEND_BASE_URL=http://localhost:5000

# MongoDB (worker-side writes, if any). Leave blank to skip.
MONGODB_URI=

# AI provider: no default. One of: gemini | openai | anthropic
AI_PROVIDER=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=

# Where rendered HTML/PDF artifacts are written (relative to worker/)
ARTIFACTS_DIR=artifacts

# Cloudinary (optional media upload from the worker)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WeasyPrint (optional). Leave blank unless you have native Pango/GTK installed.
WEASYPRINT_BASE_URL=
